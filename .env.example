# Copiar a .env.local. Solo el servidor usa estas variables.
# Base Neon que ya contiene las tablas de T11.2. No ejecutar migraciones automáticamente.
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require

# Conexión DIRECTA a la misma base Neon, sin sufijo -pooler, para LISTEN/NOTIFY.
# Recomendada. Si se omite y DATABASE_URL usa el pooler de Neon, el servidor
# deriva únicamente el host directo de ese mismo endpoint; nunca usa el pooler
# para LISTEN. Puede ser igual a DATABASE_URL cuando esa URL ya es directa.
DATABASE_LISTEN_URL=postgresql://usuario:clave@host/neondb?sslmode=require

# T11.4: DATABASE_URL debe usar un LOGIN de solo lectura (grupo
# allinstant_t114_read). Cada operación de escritura usa una cuenta LOGIN
# distinta, miembro solo del grupo NOLOGIN indicado. Configurar después de
# aplicar migración, privilegios y aprovisionamiento de roles en el entorno objetivo.
# KITCHEN_DATABASE_URL=postgresql://control_limitado:clave@host/neondb?sslmode=require
# DISPATCH_DATABASE_URL=postgresql://despacho_limitado:clave@host/neondb?sslmode=require

# T11.4: en producción, origen público interno exacto y secretos del proxy.
# El proxy debe limitar por red/sede/área, eliminar X-Alesar-Internal-Key
# recibido del cliente e insertar solo la clave del área autorizada.
# En desarrollo local se omiten: Next.js escucha solo 127.0.0.1.
# OPERATIONS_ORIGIN=https://operaciones.alesar.interno
# OPERATIONS_PROXY_KEY_SMP_CONTROL=clave-aleatoria-larga-cocina-smp
# OPERATIONS_PROXY_KEY_SMP_DISPATCH=clave-aleatoria-larga-despacho-smp
# OPERATIONS_PROXY_KEY_LM_CONTROL=clave-aleatoria-larga-cocina-lm
# OPERATIONS_PROXY_KEY_LM_DISPATCH=clave-aleatoria-larga-despacho-lm
# OPERATIONS_CSRF_SECRET=clave-aleatoria-larga-para-firmar-tokens
